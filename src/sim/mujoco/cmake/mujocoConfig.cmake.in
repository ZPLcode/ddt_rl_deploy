# mujocoConfig.cmake -- shim over the pip-installed MuJoCo (no source build).
# Generated by the 'mujoco' shim package at configure time; paths point at the
# pip wheel's libmujoco.so + include dir.

include(CMakeFindDependencyMacro)
find_dependency(OpenGL)

set(MUJOCO_VERSION       "@MUJOCO_VERSION@")
set(MUJOCO_INCLUDE_DIR   "@MUJOCO_INCLUDE_DIR@")
set(MUJOCO_INCLUDE_DIRS  "@MUJOCO_INCLUDE_DIR@")
set(MUJOCO_LIBRARY       "@MUJOCO_LIBRARY@")
set(MUJOCO_LIBRARIES     mujoco::mujoco)

if(NOT TARGET mujoco::mujoco)
  add_library(mujoco::mujoco SHARED IMPORTED)
  set_target_properties(mujoco::mujoco PROPERTIES
    IMPORTED_LOCATION             "@MUJOCO_LIBRARY@"
    IMPORTED_SONAME               "libmujoco.so.@MUJOCO_VERSION@"
    INTERFACE_INCLUDE_DIRECTORIES "@MUJOCO_INCLUDE_DIR@"
    INTERFACE_COMPILE_DEFINITIONS "mjUSEPLATFORMSIMD"
  )
endif()

set(mujoco_FOUND TRUE)
