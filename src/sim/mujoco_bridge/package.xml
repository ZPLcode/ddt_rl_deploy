<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mujoco_bridge</name>
  <version>1.0.0</version>
  <description>Self-contained MuJoCo simulator and ros2_control bridge for ddt_rl_deploy.</description>
  <maintainer email="liukexin@directdrivetech.com">lkx</maintainer>
  <license>Apache-2.0</license>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>control_toolbox</depend>
  <depend>controller_manager</depend>
  <depend>glfw3</depend>
  <depend>hardware_interface</depend>
  <depend>joint_limits</depend>
  <depend>pluginlib</depend>
  <depend>python3</depend>
  <depend>rclcpp</depend>
  <depend>rosgraph_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>urdf</depend>

  <exec_depend>effort_controllers</exec_depend>
  <exec_depend>imu_sensor_broadcaster</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros2controlcli</exec_depend>
  <exec_depend>topic_command_controller</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
